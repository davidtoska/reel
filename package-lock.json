{
  "name": "reel-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "reel-workspace",
      "workspaces": [
        "packages/*",
        "examples/*"
      ],
      "devDependencies": {
        "@types/node": "^24.19.2",
        "typescript": "^5.9.0"
      }
    },
    "examples/studio": {
      "name": "reel-studio",
      "version": "1.0.0",
      "license": "MIT",
      "dependencies": {
        "reel-format": "*",
        "reel-player": "*",
        "reel-schema": "*"
      }
    },
    "node_modules/@types/node": {
      "version": "24.19.2",
      "dev": true,
      "license": "MIT",
      "dependencies": {
        "undici-types": ">=7.24.0 <7.24.7"
      }
    },
    "node_modules/reel-format": {
      "resolved": "packages/reel-format",
      "link": true
    },
    "node_modules/reel-player": {
      "resolved": "packages/reel-player",
      "link": true
    },
    "node_modules/reel-schema": {
      "resolved": "packages/reel-schema",
      "link": true
    },
    "node_modules/reel-studio": {
      "resolved": "examples/studio",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "node_modules/undici-types": {
      "version": "7.24.6",
      "dev": true,
      "license": "MIT"
    },
    "packages/reel-format": {
      "version": "1.0.0",
      "license": "MIT",
      "engines": {
        "node": ">=18"
      }
    },
    "packages/reel-player": {
      "version": "1.0.0",
      "license": "MIT",
      "dependencies": {
        "reel-format": "^1.0.0"
      }
    },
    "packages/reel-schema": {
      "version": "1.0.0",
      "license": "MIT"
    }
  }
}
