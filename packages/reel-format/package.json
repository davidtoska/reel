{
  "name": "reel-format",
  "version": "1.0.0",
  "description": "Reel: a frozen JSON format and a dependency-free web player for timed, layered slideshows (images, video, text, shapes, narration and music) on a 16:9 canvas.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": ["reel", "slideshow", "player", "presentation", "tv", "signage", "web-component", "format"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schema.json": "./schema/reel-1.schema.json",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "schema", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  }
}
