{
  "name": "reel-format",
  "version": "1.0.1",
  "description": "Reel 1.0 for Node and browsers: TypeScript types, validation and resolving for reel/1 documents, and reading/writing .zip reel packages. No DOM, no dependencies.",
  "license": "MIT",
  "author": "davidtoska",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidtoska/reel.git",
    "directory": "packages/reel-format"
  },
  "homepage": "https://github.com/davidtoska/reel/tree/main/packages/reel-format#readme",
  "bugs": {
    "url": "https://github.com/davidtoska/reel/issues"
  },
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "reel",
    "slideshow",
    "format",
    "validation",
    "zip",
    "package"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  }
}
