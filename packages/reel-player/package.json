{
  "name": "reel-player",
  "version": "1.0.1",
  "description": "The Reel player for browsers and Electron: a ReelPlayer class that plays reel/1 stories in any HTMLElement, letterboxed 16:9, with play, pause, seek, slide navigation and full screen. No dependencies besides reel-format.",
  "license": "MIT",
  "author": "davidtoska",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidtoska/reel.git",
    "directory": "packages/reel-player"
  },
  "homepage": "https://github.com/davidtoska/reel/tree/main/packages/reel-player#readme",
  "bugs": {
    "url": "https://github.com/davidtoska/reel/issues"
  },
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "reel",
    "slideshow",
    "player",
    "story",
    "embed",
    "electron",
    "fullscreen",
    "tv",
    "signage"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "reel-format": "^1.0.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  }
}
